    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
